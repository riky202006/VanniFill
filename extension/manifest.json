{
  "manifest_version": 3,
  "name": "VaaniFill AI - Form Autofill Assistant",
  "version": "1.0.0",
  "description": "Autofill digital forms across websites using your VaaniFill verified form profiles.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "VaaniFill AI Assistant"
  }
}
