# VaaniFill AI - Backend Environment Configuration
# Copy this file to .env and provide your local credentials
# DO NOT commit real secrets or credentials to source control

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication (JWT Secret)
JWT_SECRET=your-jwt-secret-placeholder-min-32-chars

# AI & Document Processing (Google Gemini 2.5 Flash)
GEMINI_API_KEY=your-gemini-api-key-placeholder
