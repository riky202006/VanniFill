# VaaniFill AI - Backend Environment Configuration
# Copy this file to .env and provide your local credentials
# DO NOT commit real secrets or credentials to source control

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/vaanifill?schema=public"

# Authentication (Optional JWT)
JWT_SECRET=your-jwt-secret-placeholder-min-32-chars

# AI & Document Processing (Member 2 will configure)
GEMINI_API_KEY=your-gemini-api-key-placeholder
OCR_SERVICE_URL=http://localhost:8000/ocr
